{
  "admin_token": "CHANGE_ME_ADMIN_TOKEN",
  "server": {
    "host": "127.0.0.1",
    "port": 8000
  },
  "proxy": {
    "http": "",
    "https": "",
    "no_proxy": "127.0.0.1,localhost"
  },
  "secrets": {
    "acestep_api_key": "PASTE_ACESTEP_KEY_HERE",
    "_comment_multi_key": "To use multiple keys, replace a string value with an array: [\"key1\", \"key2\"] or [{\"key\": \"...\"}]. (Note: \"label\" is currently ignored.)"
  },
  "endpoints": {
    "acestep_base_url": "https://api.acemusic.ai"
  },
  "ui_defaults": {
    "acestep": {
      "model": "acemusic/acestep-v1.5-turbo",
      "audio_format": "mp3"
    }
  },
  "auth": {
    "jwt_secret": "replace-with-random-secret",
    "admin_username": "admin",
    "admin_password": "replace-with-initial-password",
    "default_daily_quota": 20
  },
  "concurrency": {
    "acestep": {
      "max_concurrent": 1,
      "rate_limit_per_sec": 1.0,
      "cooldown_sec": 3.0
    },
    "retry": {
      "max_retries": 3,
      "base_delay_sec": 2.0,
      "retryable_statuses": [429, 500, 502, 503, 504]
    },
    "queue_timeout_sec": 300
  }
}
