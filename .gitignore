# ============================================================
# you2music .gitignore
# ============================================================

# ---- Secrets / local config (ALWAYS ignore) ----
config/providers.local.json
config/*.local.json

# ---- Generated runtime data (ALWAYS ignore) ----
data/
backend/data/

# ---- Python bytecode ----
__pycache__/
*.py[cod]
*.pyc
backend/__pycache__/
backend/tests/__pycache__/
backend/providers/__pycache__/
.pytest_cache/
.tmp_python/
.tmp/

# ---- AI dev tooling noise ----
.agents/
.claude/
.codex/
.opencode/
.trellis/
AGENTS.md

# ---- OS / editor noise ----
.DS_Store
Thumbs.db
*.log
*.swp
*.swo
.vscode/
.idea/
*.sublime-*

# ---- Build artifacts ----
dist/
build/
*.egg-info/

# ---- Playwright (E2E) ----
frontend/e2e/node_modules/
frontend/e2e/test-results/
frontend/e2e/playwright-report/
